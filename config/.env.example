# QA Trust Architect — secrets & connection overrides
# Copy to the PROJECT UNDER TEST as `.env` (or the path in qa-trust.config.yaml → secrets.envFile).
# NEVER commit the real file — make sure it is in .gitignore.
# Variables already set in your shell/OS environment take precedence over this file.

# ── Azure DevOps (MVP) ──────────────────────────────────────────────────
# PAT scopes: Work Items (Read & Write), Test Management (Read & Write)
ADO_PAT=
# Optional overrides (normally taken from qa-trust.config.yaml → platform.azure-devops)
ADO_ORG_URL=
ADO_PROJECT=
# Organisation name only (e.g. "your-org"), used by the Azure DevOps MCP server
ADO_ORG=

# ── Jira + Xray (v2) ────────────────────────────────────────────────────
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=

# ── Exploratory testing accounts (v2) — referenced from domain/environments.yaml ──
# TEST_EMPLOYEE_USER=
# TEST_EMPLOYEE_PASS=
