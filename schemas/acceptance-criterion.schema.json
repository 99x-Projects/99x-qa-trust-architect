{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-trust-architect/acceptance-criterion.schema.json",
  "title": "Acceptance criterion",
  "type": "object",
  "required": ["id", "title", "format", "traces", "basis"],
  "properties": {
    "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
    "title": { "type": "string" },
    "format": { "enum": ["gherkin", "rule-table"] },
    "gherkin": { "type": "string" },
    "ruleTable": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array" } }
      }
    },
    "kind": { "enum": ["happy", "negative", "boundary", "permission", "state", "nfr", "error-handling"] },
    "traces": {
      "type": "object",
      "properties": {
        "requirements": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "array", "items": { "type": "string" } },
        "entities": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["requirements"]
    },
    "basis": { "enum": ["confirmed", "provisional"] },
    "basisRefs": { "type": "array", "items": { "type": "string" } },
    "source": { "enum": ["platform", "generated", "aidlc"] }
  },
  "allOf": [
    { "if": { "properties": { "format": { "const": "gherkin" } } }, "then": { "required": ["gherkin"] } },
    { "if": { "properties": { "format": { "const": "rule-table" } } }, "then": { "required": ["ruleTable"] } }
  ]
}
